<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Lets pkexec run yaist-helper with authentication kept for a few minutes,
  instead of asking for every step. On openSUSE, shipping a polkit policy in
  a distribution package needs a security review (polkit-default-privs).
-->
<policyconfig>
  <vendor>yAIst</vendor>
  <action id="org.opensuse.yaist.helper">
    <description>Run yAIst system administration tasks</description>
    <message>Authentication is required to manage the system with yAIst</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/yaist/yaist-helper</annotate>
  </action>
</policyconfig>
